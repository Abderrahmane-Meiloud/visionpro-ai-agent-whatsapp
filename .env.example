# --- deploy ---
DOMAIN=agent.example.com

COMPOSE_PROJECT_NAME=wa
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM

# --- app ---
NODE_ENV=production
COMPANY_NAME=VisionPro Technology
# On first boot (empty users table) a DB admin account is seeded from ADMIN_USER/ADMIN_PASSWORD so
# you can sign into the dashboard; afterwards manage staff accounts in the dashboard. ADMIN_* also
# remains a Basic-auth bootstrap/recovery credential. In production ADMIN_PASSWORD must be >= 16 chars.
ADMIN_USER=admin
ADMIN_PASSWORD=CHANGE_ME_LONG_RANDOM
# Cookie-session policy for staff logins (P2-A). Defaults shown; tune if needed.
SESSION_TTL_HOURS=168      # absolute session lifetime (7 days)
SESSION_IDLE_MINS=720      # idle timeout in minutes (12h); 0 disables the idle check
# Max characters of Approved Knowledge injected into the AI system prompt (bounded retrieval).
PROMPT_KB_CHAR_BUDGET=12000
# Schema migrations are NOT auto-applied at boot in production (they can lock a populated DB). Run
# `npm run migrate` deliberately before starting the app. Set AUTO_MIGRATE=true ONLY for dev/test.
# AUTO_MIGRATE=
# ALLOW_TEST_FAULTS is a TEST-ONLY switch for the smoke suite. The app REFUSES to boot in production
# if it is set — never set it in production.

# --- optional: a second, independent service-to-service credential (e.g. the VisionPro
# WhatsApp bridge) — leave BRIDGE_PASSWORD blank to disable; it can never authenticate until set.
BRIDGE_USER=whatsapp-bridge
BRIDGE_PASSWORD=

# --- Meta ---
META_GRAPH_API_VERSION=   # copy the current version from the Meta dashboard, e.g. vNN.0
META_APP_SECRET=
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=        # permanent system-user token for production
META_WEBHOOK_VERIFY_TOKEN=CHANGE_ME_RANDOM

# --- OpenAI (leave blank + AGENT_MOCK=true until the key exists) ---
OPENAI_API_KEY=
# gpt-5.6-terra: verified for Chat Completions + tool calling (how the agent runs). The GPT-6 tiers
# (gpt-6-luna cheaper / gpt-6-sol stronger) exist but their tool-calling on Chat Completions is NOT
# confirmed — test one live call before switching to a GPT-6 model.
OPENAI_TEXT_MODEL=gpt-5.6-terra
OPENAI_TEXT_FALLBACK_MODEL=
# gpt-transcribe is the current file-transcription model (gpt-4o-mini-transcribe is deprecated).
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
AGENT_MOCK=true
# Daily cap on REAL AI replies (rolling 24h). When AGENT_MOCK=false a non-zero cap is ALWAYS enforced:
# a positive value here wins; 0/unset falls back to REPLY_DAILY_CALL_CAP_DEFAULT. Mock mode never counts.
REPLY_DAILY_CALL_CAP=0
REPLY_DAILY_CALL_CAP_DEFAULT=1000

# --- VisionPro Marketing OS integration (catalog/products from VisionPro) ---
# Set BUSINESS_PROVIDER=visionpro to route catalog/price/stock tool calls to the Marketing OS API.
# Leave as 'local' to use the agent's own Postgres products/prices/inventory tables.
BUSINESS_PROVIDER=local
VISIONPRO_BASE_URL=
VISIONPRO_BRIDGE_EMAIL=whatsapp-bridge@internal.visionpro
VISIONPRO_BRIDGE_PASSWORD=

# --- Evolution API pilot transport (EXPERIMENTAL, owner-authorized, NON-PRODUCTION ONLY) ---
# This is NOT the project's official channel — see docs/14_WHATSAPP_POLICY_AND_COMPLIANCE.md and
# docs/26_EVOLUTION_PILOT.md for the full scope of this narrowly-authorized exception. Leave
# EVOLUTION_API_BASE_URL blank to keep this entirely off (the default); the app refuses to boot in
# production at all if anything below is set.
#
# EVOLUTION_API_BASE_URL is the Evolution API server's OWN base URL (e.g. https://your-evo-host),
# NOT the Manager UI URL — verify with `npm run check:evolution` before trusting it.
EVOLUTION_API_BASE_URL=
EVOLUTION_INSTANCE_NAME=vision
EVOLUTION_API_KEY=
# A SEPARATE, minimal listener (serves ONLY the pilot webhook route — never admin, never the Meta
# webhook) binds here. Only this port should ever be exposed via a tunnel.
EVOLUTION_WEBHOOK_PORT=3100
# Long random path segment the inbound webhook URL must include:
# /webhooks/evolution/pilot/<this value>. Generate one, e.g.: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
EVOLUTION_WEBHOOK_PATH_SECRET=
# Optional extra defense-in-depth: if set, the webhook ALSO requires a matching
# `Authorization: Bearer <this value>` header. Only effective if the Evolution instance's webhook
# config is confirmed to send custom headers back — the path secret above is the guaranteed
# fallback either way.
EVOLUTION_WEBHOOK_AUTH_HEADER=
# Master switch for AUTOMATIC AI replies on the pilot channel. Keep false until the receiver itself
# has been verified (dedup, catalog lookup, etc. all work with this off).
EVOLUTION_PILOT_AUTO_REPLY_ENABLED=false
# Comma-separated bare digit phone numbers. Even with auto-reply enabled, ONLY these numbers ever
# get an automatic reply through the pilot channel.
EVOLUTION_PILOT_ALLOWED_TEST_NUMBERS=
# REAL-inbound sender allowlist (distinct from the auto-reply allowlist above, which only applies
# AFTER a message is already saved). This one gates the real webhook route itself: fail-closed —
# empty means every real inbound message is rejected before it is ever persisted, dedupe-recorded,
# logged, or shown anywhere. Never applies to the simulator. Start with exactly ONE number here
# before any live activation. See docs/26_EVOLUTION_PILOT.md.
EVOLUTION_REAL_INBOUND_ALLOWLIST=
# Mounts a fake outbound sink + a one-page browser simulator on the SAME isolated listener, so the
# whole pipeline can be exercised with EVOLUTION_API_BASE_URL pointed back at this same process
# (e.g. http://localhost:3100) instead of any real Evolution server. Use this whenever the real
# connected number is not yet confirmed as an authorized test line. See docs/26_EVOLUTION_PILOT.md.
EVOLUTION_PILOT_SIMULATION_MODE=false
# Fail-closed master switch for REAL (non-loopback) outbound sends — manual replies, AI replies, and
# retries all converge on the same sendEvolutionText() call, so this one flag covers all three. A
# loopback EVOLUTION_API_BASE_URL (the local simulator above) is NEVER blocked by this, regardless
# of its value. Keep false until a real send has been explicitly approved. See docs/26_EVOLUTION_PILOT.md.
EVOLUTION_REAL_OUTBOUND_ENABLED=false
