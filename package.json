{
  "name": "bessma-whatsapp-agent",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && cp src/schema.sql dist/ && mkdir -p dist/modules/admin && cp src/modules/admin/admin.html dist/modules/admin/",
    "start": "node dist/index.js",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "node --import tsx scripts/smoke.ts"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "express": "^5.1.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
