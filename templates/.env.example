# App
NODE_ENV=production
APP_URL=https://agent.example.com
API_URL=https://api-agent.example.com

# Database
DATABASE_URL=postgresql://USER:PASSWORD@DB_HOST:5432/DB_NAME

# Meta WhatsApp
META_GRAPH_API_VERSION=VERIFY_CURRENT_VERSION
META_APP_ID=
META_APP_SECRET=
META_WABA_ID=
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=

# OpenAI
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-6-luna
OPENAI_TEXT_FALLBACK_MODEL=gpt-6-sol
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Future realtime voice
VOICE_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini

# Agent
AI_ENABLED=true
VOICE_NOTES_ENABLED=true
DEFAULT_LANGUAGE=hassaniya
MAX_TOOL_CALLS_PER_TURN=6

# Security
SESSION_SECRET=
ADMIN_INITIAL_PASSWORD=CHANGE_ME_AND_ROTATE
